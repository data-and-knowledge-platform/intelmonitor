# Copy to .env and fill in. Never commit .env.

# --- Required ---

# LLM: every pipeline stage (Claude Haiku 5.5 for screening, same-event, theme; the model below for
# the rest) and the Generate dashboard agent. Billed per token on the key.
# For local runs on your Claude login instead, set CLAUDE_VIA_API=0 and leave the key blank.
ANTHROPIC_API_KEY=
CLAUDE_VIA_API=1
ANTHROPIC_MODEL=claude-sonnet-5-5

# External news, gap searches and the official sites with no feed (FATF, Treasury, FCA, SGX and others).
EXA_API_KEY=

# --- Optional: structured data for trend charts ---

# Macro and FX series for country entities. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Stablecoin prices and depegs. Free demo key. DefiLlama (supply) needs no key.
COINGECKO_API_KEY=

# MAS statistics APIs (https://eservices.mas.gov.sg/apimg-portal/api-catalog).
# System-wide aggregates, not per bank. Keys go in a `keyid` request header.
# Per-API paths (e.g. /server/monthly_statistical_bulletin/table_i_3b_commercial_banks_assets/
# views/table_i_3b_commercial_banks_assets) live in code. If one key covers all, repeat it.
MAS_API_BASE_URL=https://eservices.mas.gov.sg/apimg-gw
MAS_EXCHANGE_RATES_API_KEY=
MAS_BANK_ASSET_QUALITY_API_KEY=
MAS_BANK_LIQUIDITY_API_KEY=
MAS_BANK_EXPOSURE_API_KEY=
MAS_SORA_KEY=

# --- No key needed ---
# Official sources: MAS search API; Fed, ECB, BoE, EBA, ESMA, FSB, BIS, NY Fed Liberty Street,
# Standard Chartered and Thunes RSS; HKMA open API; cloud status pages; Google Trends RSS.
# Also DefiLlama stablecoins, World Bank, GDELT.
